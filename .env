# Environment Variables for Stripe Integration
# IMPORTANT: Never commit this file to version control!

# Stripe Keys (Get these from your Stripe Dashboard)
# Test keys (start with sk_test_ and pk_test_)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Webhook secret (optional, for webhook verification)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Instructions:
# 1. Go to https://dashboard.stripe.com/test/apikeys
# 2. Copy your "Publishable key" and "Secret key"
# 3. Replace the placeholder values above with your actual keys
# 4. For production, use live keys (sk_live_ and pk_live_)
# 5. Add this file to your .gitignore to keep keys secure
