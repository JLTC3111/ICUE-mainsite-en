# =============================================================================
# ICUE Donation / Payment — environment template (sandbox / test values)
# Copy to `.env` and fill in credentials from each provider's developer portal.
# Never commit `.env` to version control.
# =============================================================================

# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

PAYMENT_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX=20

# --- PayPal — https://developer.paypal.com/dashboard/ ---
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# --- MoMo — https://developers.momo.vn/ (REST + HMAC; sandbox: test-payment.momo.vn) ---
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_PUBLIC_KEY=your_momo_public_key_pem
MOMO_ENV=test
MOMO_IPN_URL=https://your-domain.com/api/webhooks/momo
MOMO_REDIRECT_URL=https://your-domain.com/donations/success

# --- ZaloPay — https://docs.zalopay.vn/ ---
ZALOPAY_APP_ID=554
ZALOPAY_KEY1=your_sandbox_key1
ZALOPAY_KEY2=your_sandbox_key2
ZALOPAY_ENV=sandbox
ZALOPAY_CALLBACK_URL=https://your-domain.com/api/webhooks/zalopay

# --- VNPay — https://sandbox.vnpayment.vn/ ---
VNPAY_TMN_CODE=your_sandbox_tmn_code
VNPAY_HASH_SECRET=your_sandbox_hash_secret
VNPAY_ENV=sandbox
VNPAY_RETURN_URL=https://your-domain.com/donations/return
VNPAY_IPN_URL=https://your-domain.com/api/webhooks/vnpay

# --- Bank transfer (manual, no API) ---
BANK_TRANSFER_BANK_NAME=Vietcombank
BANK_TRANSFER_ACCOUNT_NAME=ICUE Vietnam
BANK_TRANSFER_ACCOUNT_NUMBER=0000000000
BANK_TRANSFER_BRANCH=Ho Chi Minh City
BANK_TRANSFER_REFERENCE_PREFIX=ICUE-DONATE

# --- Stripe (existing) ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
