{
  "name": "icue-main-site-english",
  "version": "1.0.0",
  "description": "ICUE Vietnam English website",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.17.1"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@supabase/supabase-js": "2.108.2",
    "@tailwindcss/vite": "^4.1.7",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide": "^1.24.0",
    "lucide-react": "1.24.0",
    "marked": "^16.2.0",
    "motion": "^12.42.2",
    "normalize.css": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.0",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react-test-renderer": "19.2.7",
    "vite": "^6.4.5"
  },
  "scripts": {
    "dev": "npm run build:home && node scripts/sync-home-dev.mjs && vite",
    "build": "npm run build:home && node scripts/postbuild.mjs && npm run check:production",
    "build:home": "npm run build --prefix home-app",
    "dev:home": "npm run dev --prefix home-app",
    "dev:legacy": "node scripts/restore-dev-index.mjs && vite",
    "preview": "npm run preview --prefix home-app --",
    "server": "node server.js",
    "server-dev": "node --watch server.js",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run check:routes && node scripts/check-production.mjs",
    "test:recovery": "node --experimental-vm-modules --test shared/resilience/*.test.js home-app/src/lib/homeBackgroundVideo.test.js",
    "test:audit": "node --experimental-vm-modules --test scripts/tests/*.test.mjs shared/chatbot/*.test.mjs shared/chatbot/lib/*.test.mjs",
    "sync:chatbot": "node scripts/sync-vn-chatbot.mjs"
  }
}
